  "description": "Pick-Script — S.C.R.I.P.T. point-and-click adventure engine with a ready-made play UI (React)",
  "license": "SEE LICENSE IN LICENSE-EXCEPTION.md",
  "type": "module",
  "author": {
    "name": "Aaron Davidson",
    "url": "https://github.com/aarondavidson"
